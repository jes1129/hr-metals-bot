#!/bin/sh
# ============================================================
# 資訊安全關卡（pre-push）— 九上科技 ERP
# 每次 git push 前自動掃描，夾帶金鑰/私鑰/個資就擋下 push。
# 啟用一次：  git config core.hooksPath .githooks
# 內容見：    scripts/security_scan.py
# ============================================================
if command -v python >/dev/null 2>&1; then PY=python
elif command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v py >/dev/null 2>&1; then PY=py
else
  echo "⚠️ 找不到 python，略過資安掃描（建議手動跑 scripts/security_scan.py）"
  exit 0
fi

PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "$PY" scripts/security_scan.py
code=$?
if [ "$code" -ne 0 ]; then
  echo ""
  echo "🚫 push 已被資安關卡擋下——請先處理上列項目再推。"
  echo "   若確定是公開資料/誤報：先跑  python scripts/security_scan.py --allow-warn  覆核，"
  echo "   確認無誤後可用  git push --no-verify  略過此關（請謹慎）。"
  exit 1
fi
exit 0
